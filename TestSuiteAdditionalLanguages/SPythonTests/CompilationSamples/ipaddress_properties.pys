import ipaddress

for text in ['0.0.0.0', '10.0.0.1', '100.64.0.1', '127.0.0.1',
             '169.254.1.1', '172.16.1.1', '192.0.0.9', '192.0.0.10',
             '192.0.0.11', '192.0.2.1', '224.0.0.1', '240.0.0.1',
             '255.255.255.255', '8.8.8.8', '::', '::1', '::ffff:8.8.8.8',
             '64:ff9b:1::1', '100::1', '2001:1::1', '2001:db8::1',
             '2002::1', '3fff::1', 'fc00::1', 'fe80::1', 'fec0::1', 'ff02::1']:
    address = ipaddress.ip_address(text)
    print(text, address.is_private, address.is_global, address.is_multicast,
          address.is_reserved, address.is_loopback, address.is_link_local,
          address.is_unspecified)

for text in ['10.0.0.0/8', '100.64.0.0/10', '192.0.0.0/24',
             '192.0.0.9/32', '192.0.2.0/23', '8.8.8.0/24',
             '::/0', '::1/128', '2001:db8::/32', 'fc00::/7',
             'ff00::/8', '::ffff:8.8.8.0/120']:
    network = ipaddress.ip_network(text)
    print(text, network.is_private, network.is_global,
          network.is_multicast, network.is_reserved,
          network.is_loopback, network.is_link_local,
          network.is_unspecified)

import struct


def readSbl(f_name, sampling_quant=2):
    try:
        formats = {2: "h", 4: "i", 8: "q"}
        result: list[int] = []
        if sampling_quant not in formats:
            return result
        with open(f_name, "rb") as source:
            data = source.read()
        if len(data) % sampling_quant != 0:
            return result
        return [value[0] for value in struct.iter_unpack("<" + formats[sampling_quant], data)]
    except Exception as err:
        print(err)
        return result


for value in readSbl(".codex-build/sbl-2.bin"):
    print(value)
for value in readSbl(".codex-build/sbl-4.bin", 4):
    print(value)
for value in readSbl(".codex-build/sbl-8.bin", 8):
    print(value)
print(len(readSbl(".codex-build/sbl-odd.bin")))
print(len(readSbl(".codex-build/sbl-2.bin", 3)))

add_one = lambda x: x + 1
combine = lambda x, y: x * y + 1
exclaim = lambda text: text + "!"
answer = lambda: 42
offset = 5
shifted = lambda x: x + offset
print(add_one(2))
print(combine(3, 4))
print(exclaim("ok"))
print(answer())
print(shifted(2))



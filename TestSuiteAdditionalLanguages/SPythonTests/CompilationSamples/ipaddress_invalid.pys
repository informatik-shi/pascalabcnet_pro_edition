import ipaddress

def address_result(text):
    try:
        return str(ipaddress.ip_address(text))
    except Exception:
        return 'ERROR'

for text in ['1.2.3.4', '1.2.3', '01.2.3.4', '1.2.3.256', ' 1.2.3.4',
             '::1', '[::1]', '::ffff:192.0.2.1', '::ffff:0192.0.2.1',
             'fe80::1%eth0', 'fe80::1%', '2001:db8:::1']:
    print(text, address_result(text))

def network_result(text):
    try:
        return str(ipaddress.ip_network(text))
    except Exception:
        return 'ERROR'

for text in ['192.0.2.0/24', '192.0.2.1/24', '192.0.2.0/33',
             '192.0.2.0/255.255.255.0', '192.0.2.0/0.0.0.255',
             '192.0.2.0/255.0.255.0', '2001:db8::/32', '2001:db8::/129',
             '10.0.0.0/08', '::/00']:
    print(text, network_result(text))

try:
    ipaddress.IPv4Address('999.0.0.1')
except ipaddress.AddressValueError:
    print('AddressValueError')

try:
    ipaddress.ip_network('192.0.2.1/24')
except ValueError:
    print('ValueError')

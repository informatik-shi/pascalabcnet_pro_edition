import numpy as np
import pandas as pd

matrix = np.array([[1, 2], [3, 4]])
print(matrix.shape)
print(matrix.dtype)
print(matrix.tolist())
broadcast = matrix + np.array([10, 20])
print(broadcast.tolist())
print(matrix.sum(axis=0))
print(matrix.mean())
print(np.arange(1, 6, 2).tolist())
print(np.linspace(0, 1, 3).tolist())
print(np.concatenate([np.array([1, 2]), np.array([3])]).tolist())
print(np.stack([np.array([1, 2]), np.array([3, 4])], axis=1).tolist())

table = pd.DataFrame({'x': [1, 2, 3], 'y': [10, 20, 30]})
print(table.shape)
print(table['y'].sum())
print(table['y'].mean())
print(table.iloc[1]['y'])
shifted = table['y'] + 1
print(shifted.tolist())
table.to_csv('numpy_pandas_native.csv', index=False)
loaded = pd.read_csv('numpy_pandas_native.csv')
print(loaded['y'].tolist())
print(pd.concat([table, loaded], ignore_index=True).shape)
left = pd.DataFrame({'key': [1, 2], 'a': [7, 8]})
right = pd.DataFrame({'key': [2, 3], 'b': [9, 10]})
joined = pd.merge(left, right, on='key')
print(joined.shape)
print(joined['b'].tolist())

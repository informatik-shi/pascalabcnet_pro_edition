# Run native CTest identically on all platforms and expose failures in Checks.
if(NOT DEFINED ABC_TEST_DIR OR NOT IS_DIRECTORY "${ABC_TEST_DIR}")
    message(FATAL_ERROR "Set ABC_TEST_DIR to the configured native build directory")
endif()
get_filename_component(cmake_directory "${CMAKE_COMMAND}" DIRECTORY)
find_program(ABC_CTEST_EXECUTABLE NAMES ctest HINTS "${cmake_directory}" REQUIRED)
set(arguments --test-dir "${ABC_TEST_DIR}" --output-on-failure)
if(DEFINED ABC_TEST_CONFIG)
    list(APPEND arguments -C "${ABC_TEST_CONFIG}")
endif()
execute_process(COMMAND "${ABC_CTEST_EXECUTABLE}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}${errors}")
if(NOT result EQUAL 0)
    # An annotation is readable without downloading authenticated Actions logs.
    set(diagnostic "${output}${errors}")
    string(LENGTH "${diagnostic}" length)
    if(length GREATER 45000)
        string(SUBSTRING "${diagnostic}" 0 30000 beginning)
        math(EXPR tail "${length}-14000")
        string(SUBSTRING "${diagnostic}" ${tail} -1 ending)
        set(diagnostic "${beginning}\n... output truncated ...\n${ending}")
    endif()
    string(REPLACE "%" "%25" diagnostic "${diagnostic}")
    string(REPLACE "\r" "%0D" diagnostic "${diagnostic}")
    string(REPLACE "\n" "%0A" diagnostic "${diagnostic}")
    message("::error title=Native CTest failure::${diagnostic}")
    message(FATAL_ERROR "Native tests failed (${result})")
endif()

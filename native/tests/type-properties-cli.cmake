set(directory "${ABC_TEST_DIR}/type-properties-cli")
file(MAKE_DIRECTORY "${directory}")
set(source "${directory}/Другой.Модуль.pas")
file(WRITE "${source}" "type R=record end;begin Writeln(typeof(R).FullName);Writeln(ParamCount);end.")
function(expect_output expected)
    execute_process(COMMAND "${ABC}" run "${source}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    string(REPLACE "\r\n" "\n" output "${output}")
    if(NOT status EQUAL 0 OR NOT output STREQUAL expected OR NOT error STREQUAL "")
        message(FATAL_ERROR "Source identity/arguments failed: ${status}: ${output} ${error}")
    endif()
endfunction()
expect_output("Другой.Модуль.R\n0\n")
expect_output("Program.R\n1\n" --source-name=Program --max-instructions=10000 -- --source-name=argument)
expect_output("Logical.Module.R\n0\n" --max-instructions=10000 --source-name=Logical.Module)
foreach(option IN ITEMS "--source-name=" "--source-name=Bad/Name" "--source-name=Bad\\Name" "--source-name=Bad:Name")
    execute_process(COMMAND "${ABC}" run "${source}" "${option}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT status EQUAL 2 OR NOT output STREQUAL "" OR NOT error MATCHES "E_OPTION" OR NOT error MATCHES "EN:" OR NOT error MATCHES "RU:")
        message(FATAL_ERROR "Invalid logical module must fail before execution: ${status}: ${output} ${error}")
    endif()
endforeach()
execute_process(COMMAND "${ABC}" run "${source}" --source-name=One --source-name=Two RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
if(NOT status EQUAL 2 OR NOT output STREQUAL "" OR NOT error MATCHES "E_OPTION")
    message(FATAL_ERROR "Duplicate source name option accepted")
endif()

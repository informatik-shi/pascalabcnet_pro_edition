execute_process(COMMAND "${ABC_RUNNER}" run "${ABC_SOURCE}" --max-instructions=10000 -- "два слова" "" --max-instructions=1
    RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic ENCODING UTF-8 TIMEOUT 10)
string(REPLACE "\r\n" "\n" actual "${actual}")
set(expected "3\n[два слова]\n[]\n[--max-instructions=1]\nTrue\n")
if(NOT status EQUAL 0 OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Program arguments differ: ${status}: ${actual}: ${diagnostic}")
endif()
execute_process(COMMAND "${ABC_RUNNER}" run "${ABC_SOURCE}" -- [RUNMODE] один
    RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic ENCODING UTF-8 TIMEOUT 10)
string(REPLACE "\r\n" "\n" actual "${actual}")
if(NOT status EQUAL 0 OR NOT actual STREQUAL "1\n[один]\nFalse\n")
    message(FATAL_ERROR "Run-mode source argument shift differs: ${status}: ${actual}: ${diagnostic}")
endif()
execute_process(COMMAND "${ABC_RUNNER}" check "${ABC_SOURCE}" -- argument
    RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic ENCODING UTF-8 TIMEOUT 10)
if(NOT status EQUAL 2 OR NOT actual STREQUAL "")
    message(FATAL_ERROR "Check must reject runtime arguments")
endif()
foreach(part IN ITEMS "E_OPTION" "EN: Program arguments require run" "RU: Параметры программы доступны только при запуске")
    string(FIND "${diagnostic}" "${part}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing bilingual argument diagnostic: ${diagnostic}")
    endif()
endforeach()

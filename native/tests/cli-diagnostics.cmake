if(NOT DEFINED ABC_RUNNER OR NOT DEFINED ABC_SOURCE)
  message(FATAL_ERROR "Missing CLI fixture settings")
endif()
function(expect_error source option code english russian)
  execute_process(COMMAND "${ABC_RUNNER}" check "${source}" ${option}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT status EQUAL 2 OR NOT output STREQUAL "")
    message(FATAL_ERROR "CLI startup status/output mismatch: ${status}: ${output}: ${error}")
  endif()
  foreach(part IN ITEMS "${code}" "EN: ${english}" "RU: ${russian}")
    string(FIND "${error}" "${part}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Missing bilingual CLI diagnostic '${part}': ${error}")
    endif()
  endforeach()
endfunction()
expect_error("${ABC_SOURCE}" --unknown E_OPTION "Unknown option" "Неизвестный параметр командной строки")
expect_error("${ABC_SOURCE}" --max-instructions=0 E_OPTION "Instruction limit must be a positive integer" "Предел числа инструкций должен быть положительным целым числом")
expect_error("${ABC_SOURCE}.missing" "" E_IO "Cannot open source file" "Не удалось открыть исходный файл")

if(NOT DEFINED ABC_RUNNER OR NOT DEFINED ABC_ARCHIVE OR NOT DEFINED ABC_TEST_DIR)
    message(FATAL_ERROR "Missing UTF7 reference test arguments")
endif()
set(reference_dir "${ABC_TEST_DIR}/utf7-reference")
file(MAKE_DIRECTORY "${reference_dir}")
file(ARCHIVE_EXTRACT INPUT "${ABC_ARCHIVE}" DESTINATION "${reference_dir}")
execute_process(COMMAND "${ABC_RUNNER}" "${reference_dir}/utf7-reference.bin" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "UTF7 reference test failed: ${result}")
endif()

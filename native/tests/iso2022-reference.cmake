if(NOT DEFINED ABC_RUNNER OR NOT DEFINED ABC_ARCHIVE OR NOT DEFINED ABC_TEST_DIR)
    message(FATAL_ERROR "Missing ISO reference test arguments")
endif()
set(reference_dir "${ABC_TEST_DIR}/iso2022-reference")
file(MAKE_DIRECTORY "${reference_dir}")
file(ARCHIVE_EXTRACT INPUT "${ABC_ARCHIVE}" DESTINATION "${reference_dir}")
execute_process(COMMAND "${ABC_RUNNER}" "${reference_dir}/iso2022-reference.bin" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ISO-2022/HZ reference test failed: ${result}")
endif()

if(NOT DEFINED ABC_FIXTURE_NAME)
    set(ABC_FIXTURE_NAME stdlib-compat)
endif()
if(NOT ABC_FIXTURE_NAME MATCHES "^[A-Za-z0-9_-]+$")
    message(FATAL_ERROR "Invalid fixture name")
endif()
set(input_option)
if(EXISTS "${ABC_FIXTURE_DIR}/${ABC_FIXTURE_NAME}.in")
    list(APPEND input_option INPUT_FILE "${ABC_FIXTURE_DIR}/${ABC_FIXTURE_NAME}.in")
endif()
# Isolate filesystem examples so an interrupted run cannot poison a later run.
file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" run_base)
set(run_root "${run_base}/fixture-runs")
file(MAKE_DIRECTORY "${run_root}")
file(REAL_PATH "${run_root}" run_root)
cmake_path(IS_PREFIX run_base "${run_root}" NORMALIZE safe_run_root)
if(NOT safe_run_root OR run_root STREQUAL run_base)
    message(FATAL_ERROR "Fixture temporary root is outside its build directory")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run_dir "${run_root}/${ABC_FIXTURE_NAME}-${run_id}")
file(MAKE_DIRECTORY "${run_dir}")
file(REAL_PATH "${run_dir}" run_dir)
cmake_path(IS_PREFIX run_root "${run_dir}" NORMALIZE safe_run_dir)
if(NOT safe_run_dir OR run_dir STREQUAL run_root)
    message(FATAL_ERROR "Fixture working directory is outside its temporary root")
endif()
execute_process(COMMAND "${ABC_RUNNER}" run "${ABC_FIXTURE_DIR}/${ABC_FIXTURE_NAME}.pas" ${input_option}
    WORKING_DIRECTORY "${run_dir}" RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic ENCODING UTF-8 TIMEOUT 10)
file(REMOVE_RECURSE "${run_dir}")
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Standard library program failed: ${status}\n${diagnostic}\nOutput:\n${actual}")
endif()
file(READ "${ABC_FIXTURE_DIR}/${ABC_FIXTURE_NAME}.out" expected)
string(REPLACE "\r\n" "\n" actual "${actual}")
string(REPLACE "\r\n" "\n" expected "${expected}")
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Standard library output differs.\nExpected:\n${expected}\nActual:\n${actual}")
endif()

uses System;
function Render(s: SortedSet<integer>): string := s.ToArray.JoinIntoString(',');
begin
  var root:=SSetInt(0,1,2,3,4,5,6);
  var view:=root.GetViewBetween(2,5);
  var nested:=view.GetViewBetween(3,4);
  Writeln(Render(view),' [',Render(nested),']');
  root.Remove(3);
  root.Add(7);
  Writeln(Render(view),' [',Render(nested),']');
  Writeln(view.Add(3),' ',root.Contains(3),' ',view.Remove(1),' ',root.Contains(1));
  var snapshot:=Copy(view);
  var destination:=ArrFill(6,-1);
  view.CopyTo(destination,1);
  Writeln(destination.JoinIntoString(','));
  var backwards:=view.Reverse;
  view.Remove(2);
  Writeln(backwards.ToArray.JoinIntoString(','));
  var policy: System.Collections.Generic.ISet<integer> := nested;
  policy.IntersectWith(Arr(4));
  Writeln(Render(root),' [',Render(view),'] [',Render(snapshot),']');
  view.Clear;
  Writeln(Render(root),' [',Render(view),']');
  var reverse:=System.Collections.Generic.Comparer&<integer>.Create((a,b) -> b-a);
  var descending:=new SortedSet<integer>(Arr(1,2,3,4,5,6),reverse);
  var window:=descending.GetViewBetween(5,2);
  Writeln(Render(window),' ',window.Min,' ',window.Max);
  var e:=SSetInt();
  var stale:=e.GetViewBetween(3,5);
  e.Add(4);
  stale.Clear;
  Writeln(e.Count,' ',stale.Count);
  stale.Clear;
  Writeln(e.Count,' ',stale.Count);
  var source:=SSetInt(1,2,3);
  var window2:=source.GetViewBetween(2,5);
  source.Add(4);
  var list:=Lst(9);
  list.AddRange(window2);
  Writeln(list.ToArray.JoinIntoString(','));
  source.Add(5);
  Writeln(HSetInt(2,3,4,5).SetEquals(window2));
end.

type
 Item=class(IEquatable<Item>) public id,n:integer;constructor Create(i,value:integer);begin id:=i;n:=value;end;function Equals(b:Item):boolean;begin Touch('E',Self,b);Result:=(mode<>1) and (b<>nil) and (n=b.n);end;end;

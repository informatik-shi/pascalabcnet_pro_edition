uses Collections;
type Rec=record s:string; end;
function EmptyResult:string;
begin end;
function Identity(s:string):string;
begin Result:=s; end;
procedure Clear(var s:string);
begin s:=nil; end;
begin
  var local:string; var r:Rec; var a:=new string[1];
  Writeln(local=nil,' ',r.s=nil,' ',a[0]=nil,' ',EmptyResult=nil);
  SetLength(a,3); var initial:array of string; SetLength(initial,1);
  Writeln(a[1]=nil,' ',initial[0]=nil);
  var m:=new AssocArray<string,string>;
  Writeln('[',m['missing'],'] ',m['missing']=nil,' [',m.ToString,']');
  m[nil]:='null key'; m['']:='empty key';
  Writeln(m[nil],' / ',m['']);
  var s:string:=nil;
  Writeln(s=nil,' ',s='',' ',s='nil',' ',s<'',' ',s<='',' ',s>'',' ',''>s);
  Writeln('[',s+'','] [','x'+s,'] [',nil+'x','] [',Concat(s,s),']');
  Writeln(Length(s),' [',Copy(s,1,2),'] [',LeftStr(s,2),'] [',RightStr(s,2),'] ',CompareStr(s,''));
  Writeln(Pos(s,s),' ',LastPos(s,s),' ',Pos('',s,0),' ',LastPos(s,'abc',-1));
  Writeln(StrToInt64(s),' ',StrToReal(s),' ',StrToFloat(s,'.'),' ',FileExists(s));
  Delete(s,1,2); Writeln('[',s,']');
  Insert(nil,s,1); Writeln(s=nil,' [',s,']');
  s:=nil; SetLength(s,2); Writeln('[',s,']');
  Clear(s); Writeln(Identity(s)=nil);
  WriteAllText('nil-string-text.txt',s); Writeln(Length(ReadAllText('nil-string-text.txt')));
  var lines:=new string[2]; lines[0]:=s; lines[1]:='tail';
  WriteAllLines('nil-string-lines.txt',lines); var readBack:=ReadAllLines('nil-string-lines.txt');
  Writeln(Length(readBack),' [',readBack[0],'] ',readBack[1],' ',readBack[0]=nil);
  var d:=new DynArray<string>(1); Writeln(d[0]=nil);
  d[0]:='kept'; d.Resize(0); d.Resize(1); Writeln(d[0]);
  d.Resize(8); Writeln(d[1]=nil);
  var records:=new AssocArray<string,Rec>; r:=records['x']; Writeln(r.s=nil);
  var rd:=new DynArray<Rec>(1); r:=rd[0]; Writeln(r.s=nil);
  var q:=new Queue<string>; q.Enqueue(nil); Writeln('[',q.ToString,'] ',q.Top=nil);
  var setOfStrings:=new SimpleSet<string>; setOfStrings.Add(nil); setOfStrings.Add(''); setOfStrings.Add(nil);
  Writeln(setOfStrings.Contains(nil),' ',setOfStrings.Contains(''));
  setOfStrings.Remove(nil); Writeln(setOfStrings.Contains(nil),' ',setOfStrings.Contains(''));
  var list:=new List<string>; list.Add(nil); Writeln(list.Contains(nil),' ',list.Contains(''));
  var sorted:=Arr(s,'bb','','aa'); Sort(sorted);
  Writeln('[',sorted[0],'] [',sorted[1],'] ',sorted[2],' ',sorted[3]);
  SortDescending(sorted); Writeln(sorted[0],' ',sorted[1],' [',sorted[2],'] [',sorted[3],']');
end.

uses System;
type OrderedMap = System.Collections.Generic.SortedDictionary<integer,string>;
begin
  var names:=new OrderedMap;
  names.Add(4,'four');
  names.Add(2,'two');
  names.Add(1,'one');
  names[2]:='second';
  names[9]:='nine';
  var value: string:='before';
  Writeln(names.TryGetValue(2,value),' ',value,' ',names[1],' ',names.Count);
  Writeln(names.TryGetValue(7,value),' ',value=nil,' ',names.ContainsValue('four'),' ',2 in names);
  foreach var pair in names do Write(pair.Key,':',pair.Value,' ');
  Writeln('|');
  Writeln(names.Remove(4),' ',names.Remove(4),' ',names.ContainsKey(4));
  var descending:=System.Collections.Generic.Comparer&<integer>.Create((a,b) -> b-a);
  var back:=new SortedDictionary<integer,string>(descending);
  back.Add(1,'a'); back.Add(4,'d'); back.Add(3,'c');
  Writeln(back.Comparer.Compare(4,1));
  foreach var pair in back do Write(pair.Key,':',pair.Value,' ');
  Writeln('|');
  var amounts:=new SortedDictionary<Decimal,string>;
  amounts.Add(Decimal.Parse('4.00'),'old');
  amounts[Decimal.Parse('4.0')]:='new';
  foreach var pair in amounts do Writeln(pair.Key.ToString,' ',pair.Value);
  var raw:=Dict(KV(6,'six'),KV(1,'uno'),KV(4,'quatre'));
  var dictionary: System.Collections.Generic.IDictionary<integer,string> := raw;
  var fromRaw:=new OrderedMap(raw);
  var fromInterface:=new OrderedMap(dictionary,descending);
  var reordered:=new OrderedMap(back);
  foreach var pair in fromRaw do Write(pair.Key,' ');
  Writeln('|');
  foreach var pair in fromInterface do Write(pair.Key,' ');
  Writeln('|');
  foreach var pair in reordered do Write(pair.Key,' ');
  Writeln('|');
  var pairs:=new System.Collections.Generic.KeyValuePair<integer,string>[5];
  names.CopyTo(pairs,1);
  Writeln(pairs[0].Key,' ',pairs[1].Key,' ',pairs[2].Value,' ',pairs[3].Key);
  Writeln(typeof(OrderedMap).Name,' ',typeof(OrderedMap).Namespace);
  names.Clear;
  Writeln(names.Count);
end.

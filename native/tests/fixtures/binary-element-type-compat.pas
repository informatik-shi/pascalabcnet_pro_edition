type Kind = (First, Second);
     OtherKind = (Left, Right);
begin
  var f: file of integer;
  var alias := f;
  Writeln(f.ElementType.FullName);
  alias.ElementType := typeof(byte);
  Writeln(f.ElementType.FullName);
  Writeln(f.ToString);
  Assign(f, 'mutable-element.bin');
  Rewrite(f);
  Write(f, 42, 62, 10, 255);
  Writeln(FilePos(f), ' ', FileSize(f));
  Close(f);
  var raw: file of byte;
  Assign(raw, 'mutable-element.bin');
  Reset(raw);
  var a,b,c,d: byte;
  Read(raw,a,b,c,d);
  Writeln(a, ' ', b, ' ', c, ' ', d);
  Close(raw);
  f.ElementType := typeof(integer);
  Writeln(alias.ElementType.FullName);
  Reset(f);
  var n: integer;
  Read(f,n);
  Writeln(n);
  Close(f);
  f.ElementType := nil;
  Writeln(f.ElementType = nil);

  var numbers: file of real;
  numbers.ElementType := typeof(byte);
  Assign(numbers,'rounded-elements.bin');
  Rewrite(numbers);
  Write(numbers,2.5,3.5,254.5);
  Close(numbers);
  Assign(raw,'rounded-elements.bin');
  Reset(raw);
  Read(raw,a,b,c);
  Writeln(a,' ',b,' ',c);
  Close(raw);

  var enums: file of Kind;
  enums.ElementType := typeof(integer);
  Assign(enums, 'enum-element.bin');
  Rewrite(enums);
  Write(enums, Second);
  Reset(enums);
  var value: Kind;
  Read(enums,value);
  Writeln(value);
  enums.ElementType := typeof(OtherKind);
  Reset(enums);
  Read(enums,value);
  Writeln(value);
  Close(enums);
  f.ElementType := typeof(Kind);
  Assign(f, 'enum-element.bin');
  Reset(f);
  Read(f,n);
  Writeln(n);
  Close(f);
end.

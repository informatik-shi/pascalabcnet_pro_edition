if(NOT DEFINED ABC_RUNNER OR NOT DEFINED ABC_ARCHIVE OR NOT DEFINED ABC_TEST_DIR)
    message(FATAL_ERROR "Missing binary codec reference arguments")
endif()
set(reference_dir "${ABC_TEST_DIR}/binary-codec-reference")
file(MAKE_DIRECTORY "${reference_dir}")
file(ARCHIVE_EXTRACT INPUT "${ABC_ARCHIVE}" DESTINATION "${reference_dir}")
file(SHA256 "${reference_dir}/binary-codec-reference.tsv" actual_hash)
if(NOT actual_hash STREQUAL "310ebf6ea82b80a970129d02f2d0f2010005e9d2be1197d5364aa2e1b06ab6a9")
    message(FATAL_ERROR "Binary codec reference hash differs")
endif()
execute_process(COMMAND "${ABC_RUNNER}" "${reference_dir}/binary-codec-reference.tsv" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Binary codec reference test failed: ${result}")
endif()
